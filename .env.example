# Copy to .env.local for local development. .env.production (committed) holds the live project's public values.
# Supabase project, Settings, API.
VITE_SUPABASE_URL=
# the publishable (anon) key; never the service_role key here, everything VITE_ ships to every visitor
VITE_SUPABASE_ANON_KEY=
# the schema with the league's records; production uses ypl_schema_validation
VITE_YPL_DATA_SCHEMA=ypl_schema_validation
