{
  "name": "ypl-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/*.test.mjs\"",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "data:champions": "node scripts/build-champions-data.mjs",
    "data:directory": "node scripts/build-champions-data.mjs --directory",
    "font:slices": "python scripts/build-font-slices.py",
    "build:battle": "node scripts/build-battle-engine.mjs",
    "data:cpu-learn": "node scripts/learn-cpu-sets.mjs",
    "data:battle-info": "node scripts/build-battle-info.mjs",
    "bench:cpu": "node scripts/cpu-benchmark.mjs",
    "verify:db": "node scripts/verify-league-intake-db.mjs && node scripts/verify-push-db.mjs && node scripts/verify-streak-db.mjs && node scripts/verify-team-bouts-db.mjs && node scripts/verify-tower-cups-db.mjs && node scripts/verify-battle-records-db.mjs && node scripts/verify-change-log-db.mjs && node scripts/verify-account-self-db.mjs",
    "backup": "node scripts/backup-data.mjs"
  },
  "dependencies": {
    "@smogon/calc": "^0.12.0",
    "@supabase/postgrest-js": "^2.107.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@pkmn/mods": "0.10.13",
    "@pkmn/sim": "0.10.13",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "0.21.5",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=24"
  }
}
